# Local dev: point at any reachable Postgres instance, e.g. a local
# `createdb bbt_dev` + `postgresql://<user>@localhost:5432/bbt_dev`.
# Production (Railway): use the connection string from the Postgres plugin.
DATABASE_URL="postgresql://user@localhost:5432/bbt_dev"

# Secret used to sign session JWTs (both attendee and staff cookies).
# Generate a real random value for production, e.g.: openssl rand -hex 32
AUTH_SECRET="replace-me-with-a-long-random-value"

# Google OAuth (Sign in with Google) — from Google Cloud Console > APIs &
# Services > Credentials > OAuth client ID (Web application). Redirect URI to
# register there: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Booking confirmation emails — from resend.com (free tier). Without a key,
# bookings still work fine; the email is just skipped (logged, not fatal).
RESEND_API_KEY=""
EMAIL_FROM="Big Bong Theory <onboarding@resend.dev>"

# Optional — only read by `prisma/seed.ts`, and only at the moment you run
# `npm run db:seed`. Set these (as real, random values — see the passcode
# format used by /api/staff, e.g. SUPER-1234) before seeding any database
# that isn't purely local/throwaway, so a real passcode is never hardcoded
# or committed anywhere. Omit them for local dev — the seed script falls
# back to obviously-fake placeholder passcodes when unset.
SEED_SUPER_PASSCODE=""
SEED_MOD_PASSCODE=""
SEED_GATE_PASSCODE=""
